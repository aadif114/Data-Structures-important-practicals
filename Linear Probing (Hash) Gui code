import tkinter as tk
from tkinter import messagebox


def linear_probing_insert(hash_size, data):
    hash_table = [None] * hash_size

    for value in data:
        hash_index = value % hash_size
        original_index = hash_index

        while hash_table[hash_index] is not None:
            hash_index = (hash_index + 1) % hash_size

        
            if hash_index == original_index:
                return None

        hash_table[hash_index] = value

    return hash_table

def insert_data():
    try:
        hash_size = int(size_entry.get())

        if hash_size <= 0:
            messagebox.showerror("Error", "Hash table size must be greater than 0")
            return

        data_input = data_entry.get()

        if data_input.strip() == "":
            messagebox.showerror("Error", "Please enter data")
            return

        data = list(map(int, data_input.split()))

        final_table = linear_probing_insert(hash_size, data)

        if final_table is None:
            messagebox.showerror("Error", "Hash table is full!")
            return

        
        output_text.delete("1.0", tk.END)

        output_text.insert(tk.END, "FINAL HASH TABLE\n")
        output_text.insert(tk.END, "-" * 35 + "\n\n")

        for i, value in enumerate(final_table):

            if value is None:
                output_text.insert(
                    tk.END,
                    f"Index {i}: Empty\n"
                )
            else:
                output_text.insert(
                    tk.END,
                    f"Index {i}: {value}\n"
                )

    except ValueError:
        messagebox.showerror(
            "Error",
            "Please enter valid numbers only"
        )



def clear_data():
    size_entry.delete(0, tk.END)
    data_entry.delete(0, tk.END)
    output_text.delete("1.0", tk.END)



root = tk.Tk()
root.title("Linear Probing Hashing")
root.geometry("600x650")
root.resizable(False, False)


title_label = tk.Label(
    root,
    text="LINEAR PROBING HASHING",
    font=("Arial", 22, "bold")
)
title_label.pack(pady=20)


size_label = tk.Label(
    root,
    text="Enter Hash Table Size:",
    font=("Arial", 13)
)
size_label.pack(pady=5)

size_entry = tk.Entry(
    root,
    font=("Arial", 13),
    width=30
)
size_entry.pack(pady=5)


data_label = tk.Label(
    root,
    text="Enter Data (space-separated):",
    font=("Arial", 13)
)
data_label.pack(pady=10)

data_entry = tk.Entry(
    root,
    font=("Arial", 13),
    width=40
)
data_entry.pack(pady=5)


button_frame = tk.Frame(root)
button_frame.pack(pady=20)

insert_button = tk.Button(
    button_frame,
    text="Insert",
    font=("Arial", 12, "bold"),
    width=12,
    command=insert_data
)
insert_button.grid(row=0, column=0, padx=10)

clear_button = tk.Button(
    button_frame,
    text="Clear",
    font=("Arial", 12, "bold"),
    width=12,
    command=clear_data
)
clear_button.grid(row=0, column=1, padx=10)


output_label = tk.Label(
    root,
    text="Hash Table:",
    font=("Arial", 15, "bold")
)
output_label.pack(pady=5)

output_text = tk.Text(
    root,
    font=("Courier New", 13),
    width=45,
    height=18
)
output_text.pack(pady=10)


root.mainloop()
