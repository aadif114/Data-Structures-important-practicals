            font=("Arial", 12, "bold"),
            bg="#EAF6FF"
        ).pack()

        self.input_text = tk.Text(
            frame1,
            width=95,
            height=5,
            font=("Consolas", 11)
        )

        self.input_text.pack()


        frame2 = tk.Frame(root, bg="#EAF6FF")
        frame2.pack(pady=10)

        tk.Button(
            frame2,
            text="Encode",
            width=12,
            bg="#4CAF50",
            fg="white",
            font=("Arial", 11, "bold"),
            command=self.encode
        ).grid(row=0, column=0, padx=8)

        tk.Button(
            frame2,
            text="Decode",
            width=12,
            bg="#FF9800",
            fg="white",
            font=("Arial", 11, "bold"),
            command=self.decode
        ).grid(row=0, column=1, padx=8)

        tk.Button(
            frame2,
            text="Clear",
            width=12,
            bg="#F44336",
            fg="white",
            font=("Arial", 11, "bold"),
            command=self.clear
        ).grid(row=0, column=2, padx=8)

        tk.Button(
            frame2,
            text="Exit",
            width=12,
            bg="#424242",
            fg="white",
            font=("Arial", 11, "bold"),
            command=root.destroy
        ).grid(row=0, column=3, padx=8)

        middle = tk.Frame(root, bg="#EAF6FF")
        middle.pack(fill="both", expand=True, padx=10)


        left = tk.Frame(middle, bg="#EAF6FF")
        left.pack(side="left", fill="both", expand=True, padx=10)

        tk.Label(
            left,
            text="Character Frequencies",
            font=("Arial", 12, "bold"),
            bg="#EAF6FF"
        ).pack()

        self.freq_box = tk.Text(
            left,
            width=40,
            height=12,
            font=("Consolas", 10)
        )

        self.freq_box.pack(fill="both", expand=True)


        right = tk.Frame(middle, bg="#EAF6FF")
        right.pack(side="right", fill="both", expand=True, padx=10)

        tk.Label(
            right,
            text="Huffman Codebook",
            font=("Arial", 12, "bold"),
            bg="#EAF6FF"
        ).pack()

        self.code_box = tk.Text(
            right,
            width=40,
            height=12,
            font=("Consolas", 10)
        )

        self.code_box.pack(fill="both", expand=True)

            # ==========================
    # Encode
    # ==========================

    def encode(self):

        text = self.input_text.get("1.0", tk.END).strip()

        if text == "":
            messagebox.showerror("Error", "Please enter some text.")
            return

        encoded, self.codebook, freq = huffman_encoding(text)

        # Remove old widgets if they exist
        if hasattr(self, "bottom_frame"):
            self.bottom_frame.destroy()

        # Bottom Frame
        self.bottom_frame = tk.Frame(self.root, bg="#EAF6FF")
        self.bottom_frame.pack(fill="both", expand=True, padx=10, pady=5)

        # Frequencies
        self.freq_box.delete("1.0", tk.END)
        for ch, fr in freq.items():
            self.freq_box.insert(tk.END, f"{repr(ch)} : {fr}\n")

        # Codebook
        self.code_box.delete("1.0", tk.END)
        for ch, code in self.codebook.items():
            self.code_box.insert(tk.END, f"{repr(ch)} : {code}\n")

        # Encoded Section
        tk.Label(
            self.bottom_frame,
            text="Encoded Data",
            font=("Arial", 12, "bold"),
            bg="#EAF6FF"
        ).pack(anchor="w")

        self.encoded_box = tk.Text(
            self.bottom_frame,
            height=4,
            font=("Consolas", 10)
        )
        self.encoded_box.pack(fill="x", pady=5)

        self.encoded_box.insert(tk.END, encoded)

        # Decoded Section
        tk.Label(
            self.bottom_frame,
            text="Decoded Data",
            font=("Arial", 12, "bold"),
            bg="#EAF6FF"
        ).pack(anchor="w")

        self.decoded_box = tk.Text(
            self.bottom_frame,
            height=4,
            font=("Consolas", 10)
        )
        self.decoded_box.pack(fill="x")

        messagebox.showinfo("Success", "Encoding Completed Successfully!")

    # ==========================
    # Decode
    # ==========================

    def decode(self):

        if not self.codebook:
            messagebox.showerror("Error", "Please encode text first.")
            return

        encoded = self.encoded_box.get("1.0", tk.END).strip()

        decoded = huffman_decoding(encoded, self.codebook)

        self.decoded_box.delete("1.0", tk.END)
        self.decoded_box.insert(tk.END, decoded)

        messagebox.showinfo("Success", "Decoding Completed Successfully!")

    # ==========================
    # Clear
    # ==========================

    def clear(self):

        self.input_text.delete("1.0", tk.END)
        self.freq_box.delete("1.0", tk.END)
        self.code_box.delete("1.0", tk.END)

        if hasattr(self, "encoded_box"):
            self.encoded_box.destroy()

        if hasattr(self, "decoded_box"):
            self.decoded_box.destroy()

        if hasattr(self, "bottom_frame"):
            self.bottom_frame.destroy()

        self.codebook = {}

root = tk.Tk()
app = HuffmanGUI(root)
