import tkinter as tk
from tkinter import messagebox

SIZE = 10
hash_table = [-1] * SIZE


def hash_function(key):
    return key % SIZE



def insert():
    try:
        key = int(entry_key.get())
    except ValueError:
        messagebox.showerror(
            "Invalid Input",
            "Please enter a valid integer."
        )
        return

    index = hash_function(key)

    if hash_table[index] == -1:

        hash_table[index] = key

        update_table()

        status_label.config(
            text=f"✓ {key} inserted at index {index}",
            fg="green"
        )

        entry_key.delete(0, tk.END)
        entry_key.focus()

    else:

        messagebox.showwarning(
            "Collision",
            f"Index {index} is already occupied by "
            f"{hash_table[index]}.\n\n"
            "Collisions are not handled in this program."
        )



def delete():

    try:
        key = int(entry_key.get())
    except ValueError:

        messagebox.showerror(
            "Invalid Input",
            "Please enter a valid integer."
        )

        return

    index = hash_function(key)

    if hash_table[index] == key:

        hash_table[index] = -1

        update_table()

        status_label.config(
            text=f"✓ {key} deleted successfully",
            fg="green"
        )

        entry_key.delete(0, tk.END)
        entry_key.focus()

    else:

        messagebox.showwarning(
            "Not Found",
            f"{key} was not found in the hash table."
        )



def traverse():

    update_table()

    elements = []

    for i in range(SIZE):

        if hash_table[i] != -1:
            elements.append(
                f"Index {i}: {hash_table[i]}"
            )

        else:
            elements.append(
                f"Index {i}: Empty"
            )

    messagebox.showinfo(
        "Hash Table Contents",
        "\n".join(elements)
    )

    status_label.config(
        text="Hash table displayed successfully.",
        fg="blue"
    )



def update_table():

    for i in range(SIZE):

        if hash_table[i] == -1:

            table_labels[i].config(
                text="Empty",
                bg="#f1f5f9",
                fg="#64748b"
            )

        else:

            table_labels[i].config(
                text=str(hash_table[i]),
                bg="#d1fae5",
                fg="#065f46"
            )


def clear_input():

    entry_key.delete(0, tk.END)
    entry_key.focus()

    status_label.config(
        text="Input cleared.",
        fg="#334155"
    )



def exit_app():

    root.destroy()



root = tk.Tk()

