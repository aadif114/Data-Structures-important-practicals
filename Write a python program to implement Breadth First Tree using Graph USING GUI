import tkinter as tk
from tkinter import messagebox
from collections import deque, defaultdict


# --------------------------------
# Graph Class
# --------------------------------
class Graph:

    def __init__(self):
        self.graph = defaultdict(list)

    def add_vertex(self, vertex):
        if vertex not in self.graph:
            self.graph[vertex] = []

    def add_edge(self, vertex1, vertex2):
        if vertex1 in self.graph and vertex2 in self.graph:
            self.graph[vertex1].append(vertex2)
            self.graph[vertex2].append(vertex1)

    def bfs_tree(self, start):

        visited = set()
        bfs_tree = defaultdict(list)

        queue = deque([start])
        visited.add(start)

        while queue:

            current = queue.popleft()

            for neighbor in self.graph[current]:

                if neighbor not in visited:

                    visited.add(neighbor)

                    bfs_tree[current].append(neighbor)

                    queue.append(neighbor)

        return bfs_tree

    def display(self):

        result = ""

        for vertex, edges in self.graph.items():
            result += f"{vertex}: {edges}\n"

        return result


# --------------------------------
# Print BFS Tree
# --------------------------------
def print_bfs_tree(bfs_tree, start):

    result = f"Breadth-First Tree starting from {start}:\n"
    result += "-" * 40 + "\n"

    for vertex in bfs_tree:
        result += f"{vertex}: {bfs_tree[vertex]}\n"

    return result


# --------------------------------
# Create Graph
# --------------------------------
def create_graph():

    try:

        vertices_input = vertex_entry.get().strip()

        if vertices_input == "":
            messagebox.showerror(
                "Error",
                "Please enter vertices"
            )
            return

        vertices = vertices_input.split()

        g = Graph()

        # Add vertices
        for v in vertices:
            g.add_vertex(v)

        # Add edges
        edges_input = edge_entry.get().strip()

        if edges_input != "":

            edges = edges_input.split(",")

            for edge in edges:

                parts = edge.strip().split()

                if len(parts) != 2:
                    messagebox.showerror(
                        "Error",
                        "Enter edges like: A B, A C, B D"
                    )
                    return

                vertex1 = parts[0]
                vertex2 = parts[1]

                if vertex1 not in g.graph or vertex2 not in g.graph:
                    messagebox.showerror(
                        "Error",
                        f"Invalid edge: {vertex1} {vertex2}"
                    )
                    return

                g.add_edge(vertex1, vertex2)

        # Starting vertex
        start = start_entry.get().strip()

        if start == "":
            messagebox.showerror(
                "Error",
                "Please enter starting vertex"
            )
            return

        if start not in g.graph:
            messagebox.showerror(
                "Error",
                f"Starting vertex {start} does not exist"
            )
            return

        # BFS
        bfs_result = g.bfs_tree(start)

        # Display output
        output_text.delete("1.0", tk.END)

        output_text.insert(
            tk.END,
            "GRAPH\n"
        )

        output_text.insert(
            tk.END,
            "================================\n"
        )

        output_text.insert(
            tk.END,
            g.display()
        )

        output_text.insert(
            tk.END,
            "\n"
        )

        output_text.insert(
            tk.END,
            print_bfs_tree(bfs_result, start)
        )

    except Exception as e:

        messagebox.showerror(
            "Error",
            str(e)
        )


