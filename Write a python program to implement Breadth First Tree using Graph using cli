from collections import deque, defaultdict


class Graph:

    def __init__(self):
        self.graph = defaultdict(list)

    def add_vertex(self, vertex):
        if vertex not in self.graph:
            self.graph[vertex] = []

    def add_edge(self, vertex1, vertex2):
        if vertex1 in self.graph and vertex2 in self.graph:
            self.graph[vertex1].append(vertex2)
            self.graph[vertex2].append(vertex1)

    def bfs_tree(self, start):
        visited = set()
        bfs_tree = defaultdict(list)

        queue = deque([start])
        visited.add(start)

        while queue:
            current = queue.popleft()

            for neighbor in self.graph[current]:
                if neighbor not in visited:
                    visited.add(neighbor)
                    bfs_tree[current].append(neighbor)
                    queue.append(neighbor)

        return bfs_tree

    def display(self):
        for vertex, edges in self.graph.items():
            print(f"{vertex}: {edges}")


def print_bfs_tree(bfs_tree, start):
    print(f"\nBreadth-First Tree starting from {start}:")
    print("----------------------------------------")

    for vertex in bfs_tree:
        print(f"{vertex}: {bfs_tree[vertex]}")


# -------------------------------
# Main Program
# -------------------------------

g = Graph()

# Add vertices
vertices = input("Enter vertices (space-separated): ").split()

for v in vertices:
    g.add_vertex(v)


# Add edges
print("\nEnter edges one by one.")
print("Example: A B")
print("Enter 'done' when finished.")

while True:

    edge = input("Enter edge: ")

    if edge.lower() == "done":
        break

    parts = edge.split()

    if len(parts) != 2:
        print("Please enter two vertices.")
        continue

    vertex1 = parts[0]
    vertex2 = parts[1]

    if vertex1 in g.graph and vertex2 in g.graph:
        g.add_edge(vertex1, vertex2)
    else:
        print("Vertex does not exist.")


# Display Graph
print("\nGraph:")
print("----------------------------------------")
g.display()


# Starting vertex
start_vertex = input("\nEnter starting vertex for BFS: ")

if start_vertex not in g.graph:
    print("Starting vertex does not exist.")
else:

    # Perform BFS
    bfs_tree = g.bfs_tree(start_vertex)

    # Display BFS Tree
    print_bfs_tree(bfs_tree, start_vertex)
