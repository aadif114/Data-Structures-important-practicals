import tkinter as tk
from tkinter import messagebox
import heapq
from collections import Counter


class Node:
    def __init__(self, char=None, freq=None):
        self.char = char
        self.freq = freq
        self.left = None
        self.right = None

    def __lt__(self, other):
        return self.freq < other.freq


def build_huffman_tree(frequencies):
    heap = [Node(char, freq) for char, freq in frequencies.items()]
    heapq.heapify(heap)

    while len(heap) > 1:
        left = heapq.heappop(heap)
        right = heapq.heappop(heap)

        merged = Node(freq=left.freq + right.freq)
        merged.left = left
        merged.right = right

        heapq.heappush(heap, merged)

    return heap[0]


def generate_codes(node, prefix="", codebook=None):
    if codebook is None:
        codebook = {}

    if node:
        if node.char is not None:
            codebook[node.char] = prefix if prefix else "0"

        generate_codes(node.left, prefix + "0", codebook)
        generate_codes(node.right, prefix + "1", codebook)

    return codebook


def huffman_encoding(data):
    if not data:
        return "", {}, {}

    frequencies = Counter(data)
    root = build_huffman_tree(frequencies)
    codebook = generate_codes(root)

    encoded = "".join(codebook[ch] for ch in data)

    return encoded, codebook, frequencies


def huffman_decoding(encoded_data, codebook):
    reverse = {v: k for k, v in codebook.items()}

    decoded = ""
    current = ""

    for bit in encoded_data:
        current += bit
        if current in reverse:
            decoded += reverse[current]
            current = ""

    return decoded


class HuffmanGUI:

    def __init__(self, root):
        self.root = root
        self.root.title("Huffman Coding")
        self.root.geometry("800x650")

        self.codebook = {}

        tk.Label(root,
                 text="HUFFMAN CODING",
                 font=("Arial", 18, "bold")).pack(pady=10)

        tk.Label(root,
                 text="Enter Text:",
                 font=("Arial", 12)).pack()

        self.input_text = tk.Text(root, height=5, width=70)
        self.input_text.pack()

        tk.Button(root,
                  text="Encode",
                  width=15,
                  command=self.encode).pack(pady=5)

        tk.Button(root,
                  text="Decode",
                  width=15,
                  command=self.decode).pack(pady=5)

        tk.Button(root,
                  text="Clear",
                  width=15,
                  command=self.clear).pack(pady=5)

        tk.Label(root,
                 text="Character Frequencies",
                 font=("Arial", 12, "bold")).pack()

        self.freq_box = tk.Text(root, height=6, width=70)
        self.freq_box.pack()

        tk.Label(root,
                 text="Huffman Codebook",
                 font=("Arial", 12, "bold")).pack()

        self.code_box = tk.Text(root, height=6, width=70)
        self.code_box.pack()

        tk.Label(root,
                 text="Encoded Data",
                 font=("Arial", 12, "bold")).pack()

        self.encoded_box = tk.Text(root, height=6, width=70)
        self.encoded_box.pack()

        tk.Label(root,
                 text="Decoded Data",
                 font=("Arial", 12, "bold")).pack()

        self.decoded_box = tk.Text(root, height=4, width=70)
        self.decoded_box.pack()

    def encode(self):

        text = self.input_text.get("1.0", tk.END).strip()

        if text == "":
            messagebox.showerror("Error", "Please enter some text.")
            return

        encoded, self.codebook, frequencies = huffman_encoding(text)

        self.freq_box.delete("1.0", tk.END)
        self.code_box.delete("1.0", tk.END)
        self.encoded_box.delete("1.0", tk.END)
        self.decoded_box.delete("1.0", tk.END)

        self.freq_box.insert(tk.END, str(dict(frequencies)))

        for ch, code in self.codebook.items():
            self.code_box.insert(tk.END, f"{repr(ch)} : {code}\n")

        self.encoded_box.insert(tk.END, encoded)

    def decode(self):

        if not self.codebook:
            messagebox.showerror("Error", "Encode the text first.")
            return

        encoded = self.encoded_box.get("1.0", tk.END).strip()

        decoded = huffman_decoding(encoded, self.codebook)

        self.decoded_box.delete("1.0", tk.END)
        self.decoded_box.insert(tk.END, decoded)

    def clear(self):

        self.input_text.delete("1.0", tk.END)
        self.freq_box.delete("1.0", tk.END)
        self.code_box.delete("1.0", tk.END)
        self.encoded_box.delete("1.0", tk.END)
        self.decoded_box.delete("1.0", tk.END)

        self.codebook = {}


root = tk.Tk()
app = HuffmanGUI(root)
root.mainloop()
