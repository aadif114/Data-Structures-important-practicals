import tkinter as tk
from tkinter import messagebox


class QueueGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("Queue Simulator")
        self.root.geometry("650x550")
        self.root.resizable(False, False)

        self.queue = []
        self.front = -1
        self.rear = -1
        self.size = 0

        self.queue_type = tk.StringVar(value="Linear")

        title = tk.Label(root, text="Queue & Circular Queue Simulator",
                         font=("Arial", 18, "bold"))
        title.pack(pady=10)

        frame1 = tk.Frame(root)
        frame1.pack()

        tk.Label(frame1, text="Queue Size:", font=("Arial", 12)).grid(row=0, column=0)

        self.size_entry = tk.Entry(frame1, width=8)
        self.size_entry.grid(row=0, column=1)

        tk.Button(frame1, text="Create Queue",
                  command=self.create_queue).grid(row=0, column=2, padx=10)

        frame2 = tk.Frame(root)
        frame2.pack(pady=10)

        tk.Radiobutton(frame2, text="Linear Queue",
                       variable=self.queue_type,
                       value="Linear").pack(side="left", padx=20)

        tk.Radiobutton(frame2, text="Circular Queue",
                       variable=self.queue_type,
                       value="Circular").pack(side="left", padx=20)

        frame3 = tk.Frame(root)
        frame3.pack()

        tk.Label(frame3, text="Task:", font=("Arial", 12)).grid(row=0, column=0)

        self.task_entry = tk.Entry(frame3, width=25)
        self.task_entry.grid(row=0, column=1)

        frame4 = tk.Frame(root)
        frame4.pack(pady=15)

        tk.Button(frame4, text="Enqueue", width=12,
                  command=self.enqueue).grid(row=0, column=0, padx=5)

        tk.Button(frame4, text="Dequeue", width=12,
                  command=self.dequeue).grid(row=0, column=1, padx=5)

        tk.Button(frame4, text="Display", width=12,
                  command=self.display).grid(row=0, column=2, padx=5)

        tk.Button(frame4, text="Is Empty?", width=12,
                  command=self.is_empty).grid(row=0, column=3, padx=5)

        tk.Button(frame4, text="Is Full?", width=12,
                  command=self.is_full).grid(row=0, column=4, padx=5)

        self.output = tk.Text(root, width=70, height=15)
        self.output.pack(pady=10)

    def create_queue(self):
        try:
            self.size = int(self.size_entry.get())
            self.queue = [None] * self.size
            self.front = -1
            self.rear = -1
            self.output.delete(1.0, tk.END)
            self.output.insert(tk.END, "Queue Created Successfully.\n")
        except:
            messagebox.showerror("Error", "Enter valid queue size.")

    def enqueue(self):
        task = self.task_entry.get()

        if task == "":
            messagebox.showwarning("Warning", "Enter a task.")
            return

        if self.queue_type.get() == "Linear":

            if self.rear == self.size - 1:
                messagebox.showerror("Overflow", "Linear Queue Full")
                return

            if self.front == -1:
                self.front = 0

            self.rear += 1
            self.queue[self.rear] = task

        else:

            if (self.rear + 1) % self.size == self.front:
                messagebox.showerror("Overflow", "Circular Queue Full")
                return

            if self.front == -1:
                self.front = self.rear = 0
            else:
                self.rear = (self.rear + 1) % self.size

            self.queue[self.rear] = task

        self.output.insert(tk.END, f"Enqueued : {task}\n")
        self.task_entry.delete(0, tk.END)

    def dequeue(self):

        if self.front == -1:
            messagebox.showerror("Underflow", "Queue Empty")
            return

        task = self.queue[self.front]
        self.output.insert(tk.END, f"Dequeued : {task}\n")

        if self.front == self.rear:
            self.front = self.rear = -1
        else:
            if self.queue_type.get() == "Linear":
                self.front += 1
            else:
                self.front = (self.front + 1) % self.size

    def display(self):

        self.output.insert(tk.END, "\nCurrent Queue\n")

        if self.front == -1:
            self.output.insert(tk.END, "Queue Empty\n")
            return

        if self.queue_type.get() == "Linear":
            for i in range(self.front, self.rear + 1):
                self.output.insert(tk.END, str(self.queue[i]) + "\n")
        else:
            i = self.front
            while True:
                self.output.insert(tk.END, str(self.queue[i]) + "\n")
                if i == self.rear:
                    break
                i = (i + 1) % self.size

        self.output.insert(tk.END, "\n")

    def is_empty(self):
        if self.front == -1:
            messagebox.showinfo("Queue", "Queue is Empty")
        else:
            messagebox.showinfo("Queue", "Queue is Not Empty")

    def is_full(self):

        if self.queue_type.get() == "Linear":
            full = self.rear == self.size - 1
        else:
            full = (self.rear + 1) % self.size == self.front

        if full:
            messagebox.showinfo("Queue", "Queue is Full")
        else:
            messagebox.showinfo("Queue", "Queue is Not Full")


root = tk.Tk()
QueueGUI(root)
root.mainloop()
