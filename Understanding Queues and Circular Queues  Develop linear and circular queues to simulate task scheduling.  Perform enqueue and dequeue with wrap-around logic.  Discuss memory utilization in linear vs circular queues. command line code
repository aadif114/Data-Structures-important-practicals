# ---------------- Linear Queue ---------------- #

class LinearQueue:
    def __init__(self, size):
        self.size = size
        self.queue = [None] * size
        self.front = -1
        self.rear = -1

    def is_empty(self):
        return self.front == -1

    def is_full(self):
        return self.rear == self.size - 1

    def enqueue(self, task):
        if self.is_full():
            print("Linear Queue Overflow!")
            return

        if self.front == -1:
            self.front = 0

        self.rear += 1
        self.queue[self.rear] = task
        print(f"Task '{task}' added successfully.")

    def dequeue(self):
        if self.is_empty():
            print("Linear Queue Underflow!")
            return

        task = self.queue[self.front]
        print(f"Task '{task}' completed.")

        if self.front == self.rear:
            self.front = self.rear = -1
        else:
            self.front += 1

    def display(self):
        if self.is_empty():
            print("Queue is Empty.")
        else:
            print("Tasks in Linear Queue:")
            for i in range(self.front, self.rear + 1):
                print(self.queue[i])


# ---------------- Circular Queue ---------------- #

class CircularQueue:
    def __init__(self, size):
        self.size = size
        self.queue = [None] * size
        self.front = -1
        self.rear = -1

    def is_empty(self):
        return self.front == -1

    def is_full(self):
        return (self.rear + 1) % self.size == self.front

    def enqueue(self, task):
        if self.is_full():
            print("Circular Queue Overflow!")
            return

        if self.front == -1:
            self.front = self.rear = 0
        else:
            self.rear = (self.rear + 1) % self.size

        self.queue[self.rear] = task
        print(f"Task '{task}' added successfully.")

    def dequeue(self):
        if self.is_empty():
            print("Circular Queue Underflow!")
            return

        task = self.queue[self.front]
        print(f"Task '{task}' completed.")

        if self.front == self.rear:
            self.front = self.rear = -1
        else:
            self.front = (self.front + 1) % self.size

    def display(self):
        if self.is_empty():
            print("Queue is Empty.")
            return

        print("Tasks in Circular Queue:")
        i = self.front

        while True:
            print(self.queue[i])

            if i == self.rear:
                break

            i = (i + 1) % self.size


# ---------------- Main Program ---------------- #

def main():

    size = int(input("Enter Queue Size: "))

    print("\n1. Linear Queue")
    print("2. Circular Queue")

    qtype = int(input("Choose Queue Type: "))

    if qtype == 1:
        queue = LinearQueue(size)
    elif qtype == 2:
        queue = CircularQueue(size)
    else:
        print("Invalid Queue Type!")
        return

    while True:

        print("\n========== MENU ==========")
        print("1. Enqueue Task")
        print("2. Dequeue Task")
        print("3. Display Queue")
        print("4. Check if Empty")
        print("5. Check if Full")
        print("6. Exit")

        try:
            choice = int(input("Enter Choice: "))
        except ValueError:
            print("Please enter a valid number.")
            continue

        if choice == 1:
            task = input("Enter Task Name: ")
            queue.enqueue(task)

        elif choice == 2:
            queue.dequeue()

        elif choice == 3:
            queue.display()

        elif choice == 4:
            if queue.is_empty():
                print("Queue is Empty.")
            else:
                print("Queue is Not Empty.")

        elif choice == 5:
            if queue.is_full():
                print("Queue is Full.")
            else:
                print("Queue is Not Full.")

        elif choice == 6:
            print("Exiting Program...")
            break

        else:
            print("Invalid Choice! Please try again.")


if __name__ == "__main__":
    main()
